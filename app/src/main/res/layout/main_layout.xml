<?xml version="1.0" encoding="utf-8"?>

<!-- Icon toolbar along the top, one page per icon; the Picture page (landing_page.xml) is what the
     pane opens on. Long-press an icon for its name. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginLeft="3dp"
    android:layout_marginRight="3dp"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/tab_picture"
            style="@style/toolbarIcon"
            android:contentDescription="@string/tab_picture"
            android:src="@drawable/ic_tab_picture"
            android:tooltipText="@string/tab_picture" />

        <ImageButton
            android:id="@+id/tab_services"
            style="@style/toolbarIcon"
            android:contentDescription="@string/tab_services"
            android:src="@drawable/ic_tab_services"
            android:tooltipText="@string/tab_services" />

        <ImageButton
            android:id="@+id/tab_layers"
            style="@style/toolbarIcon"
            android:contentDescription="@string/tab_layers"
            android:src="@drawable/ic_tab_layers"
            android:tooltipText="@string/tab_layers" />

        <ImageButton
            android:id="@+id/tab_alerts"
            style="@style/toolbarIcon"
            android:contentDescription="@string/tab_alerts"
            android:src="@drawable/ic_tab_alerts"
            android:tooltipText="@string/tab_alerts" />

        <ImageButton
            android:id="@+id/tab_log"
            style="@style/toolbarIcon"
            android:contentDescription="@string/tab_log"
            android:src="@drawable/ic_tab_log"
            android:tooltipText="@string/tab_log" />

        <ImageButton
            android:id="@+id/tab_settings"
            style="@style/toolbarIcon"
            android:contentDescription="@string/tab_settings"
            android:src="@drawable/ic_tab_settings"
            android:tooltipText="@string/tab_settings" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <include
        android:id="@+id/picture_page"
        layout="@layout/landing_page"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <ScrollView
        android:id="@+id/services_page"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone"
        android:fadeScrollbars="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name" />

            <CheckBox
                android:id="@+id/local_toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/run_on_device" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/remote_address_label" />

            <EditText
                android:id="@+id/remote_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/remote_address_hint"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:text="@string/remote_address_default" />

            <!-- Calculation examples: one button per shape of the old REST API (calc.proto) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/calc_examples" />

            <Button
                android:id="@+id/btn_range"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/range_bearing" />

            <Button
                android:id="@+id/btn_optimise"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/optimise_route" />

            <Button
                android:id="@+id/btn_render"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/render_heatmap" />

            <Button
                android:id="@+id/btn_cancel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cancel" />

            <ProgressBar
                android:id="@+id/progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:visibility="gone" />

            <TextView
                android:id="@+id/output"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textIsSelectable="true" />

            <!-- Shown once 3. has put an image on the map -->
            <LinearLayout
                android:id="@+id/coverage_controls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/coverage_opacity" />

                <SeekBar
                    android:id="@+id/coverage_opacity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="70" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_share"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/coverage_share" />

                    <Button
                        android:id="@+id/btn_remove"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/coverage_remove" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Shared by the icons that don't have a page yet -->
    <TextView
        android:id="@+id/placeholder_page"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="16dp"
        android:textColor="@color/text_secondary"
        android:visibility="gone" />
</LinearLayout>
