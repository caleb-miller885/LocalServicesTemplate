<?xml version="1.0" encoding="utf-8"?>
<!--
    Picture page: three lists behind one segment strip.
    All three segments, with their counts, are always on screen, so the operator sees the whole
    picture without opening anything. Tap a segment, or swipe the list left/right, to change list.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/seg_nodes"
            style="@style/listSegment" />

        <TextView
            android:id="@+id/seg_waypoints"
            style="@style/listSegment" />

        <TextView
            android:id="@+id/seg_zones"
            style="@style/listSegment" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <!-- How the list is sorted and what a tap does -->
    <TextView
        android:id="@+id/list_caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="2dp"
        android:textColor="@color/text_secondary"
        android:textSize="11sp" />

    <!-- The rows of the list showing: LandingPane adds each item's own row view here -->
    <com.atakmap.android.localsvctemplate.plugin.landing.SwipeScrollView
        android:id="@+id/landing_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fadeScrollbars="false">

        <LinearLayout
            android:id="@+id/landing_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </com.atakmap.android.localsvctemplate.plugin.landing.SwipeScrollView>

    <!-- Shown in place of the list when it has no rows -->
    <TextView
        android:id="@+id/landing_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="16dp"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- Only under the Zones list: opens the zone toolbar on the map -->
    <Button
        android:id="@+id/btn_draw_zones"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_margin="6dp"
        android:background="@drawable/new_dark_button_bg"
        android:text="@string/draw_zones"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>
