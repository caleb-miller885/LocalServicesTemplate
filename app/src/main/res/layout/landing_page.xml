<?xml version="1.0" encoding="utf-8"?>
<!--
    Picture page: three lists behind one segment strip.
    All three segments, with their counts, are always on screen, so the operator sees the whole
    picture without opening anything. Tap a segment, or swipe the list left/right, to change list.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/seg_nodes"
            style="@style/listSegment" />

        <TextView
            android:id="@+id/seg_waypoints"
            style="@style/listSegment" />

        <TextView
            android:id="@+id/seg_zones"
            style="@style/listSegment" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <!-- How the list is sorted and what a tap does -->
    <TextView
        android:id="@+id/list_caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="2dp"
        android:textColor="@color/text_secondary"
        android:textSize="11sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/landing_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@color/divider"
            android:dividerHeight="1dp"
            android:listSelector="@color/pressed"
            android:fadeScrollbars="false" />

        <TextView
            android:id="@+id/landing_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="16dp"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />
    </FrameLayout>
</LinearLayout>
